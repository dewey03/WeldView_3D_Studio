*.msi
*.dmg
*.zip
*.7z

# ---- 构建与打包中间产物 ----
dist/
build/
out/
release/
*.spec

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Node ----
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

